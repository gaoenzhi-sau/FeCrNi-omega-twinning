#--------------------记录平衡后的 z 方向盒子长度（用于后续计算应变）
variable tmp equal "lz"  #临时变量存储当前 z 方向长度
variable L0 equal ${tmp}  #定义 L0 为初始长度（拉伸前的平衡长度）
variable L0 equal 198.03  
print "Initial Length, L0: ${L0}"  #输出初始长度，便于验证
Initial Length, L0: 198.03
#-------------单轴拉伸变形阶段
reset_timestep 0  #重置时间步计数器为 0（拉伸阶段作为新起点）
unfix			2
fix				2 all npt temp 300 300 0.01 x 0 0 0.1 y 0 0 0.1
fix 3 all deform 1 z erate 0.001 units box remap x
#---------------------定义应变和应力变量：
variable strain equal "(lz - v_L0)/v_L0"  #工程应变 =（当前x长度 - 初始长度）/ 初始长度
variable p1 equal "v_strain"              #p1 对应工程应变（无量纲）
variable p2 equal "-pxx/10000"            #x 方向应力（GPa）：pxx 为 LAMMPS 内置压力张量（单位 bar），负号转为拉应力，除以 10000 转换为 GPa
variable p3 equal "-pyy/10000"            #y 方向应力（GPa）
variable p4 equal "-pzz/10000"            #z 方向应力（GPa）
#----------------输出应变-应力数据到文件：
#- 每 100 步输出一次 p1（应变）、p2（x 应力）、p3（y 应力）、p4（z 应力）
#- 保存到 FeNiGr_tens_100.def1.txt，不在屏幕显示
fix def1 all print 100 "${p1} ${p2} ${p3} ${p4}" file FeNiGr_tens_100.def1.txt screen no
#----------------输出原子轨迹文件（用于可视化）：
#- 每 1000 步保存一次，文件名为 md.lammpstrj
#- 包含原子 ID、类型、x/y/z 坐标
dump trace all custom 1000 md.lammpstrj id type x y z
#热力学信息输出设置：
thermo 1000  #每 1000 步输出一次
thermo_style custom step v_strain temp v_p2 v_p3 v_p4 ke pe press  #输出步数、应变、温度、三方向应力、动能、势能、总压力
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/output.cpp:1100)
run 300000  #拉伸阶段运行 300000 步（总时间 300ps，累积应变约0.3）
