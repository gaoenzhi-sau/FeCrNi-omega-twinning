# ---------- 施加滑移 ----------
# 1. 如果 x_displace 小于等于 b_vec，整个 upper0 移动到 x_displace
if "${x_displace} <= ${b_vec}" then    "displace_atoms upper0 move -${x_displace} 0.0 0.0 units box"

# 2. 如果 x_displace 大于 b_vec 且小于等于 2b_vec
if "${x_displace} > ${b_vec} && ${x_displace} <= ${2b_vec}" then    "displace_atoms top1 move -${b_vec} 0.0 0.0 units box"    "displace_atoms top2 move -${x_displace} 0.0 0.0 units box"    "displace_atoms top3 move -${x_displace} 0.0 0.0 units box"
