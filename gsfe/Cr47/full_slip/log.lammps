variable xdim equal 77.05028017
variable ydim equal 105.52861602
variable b_vec equal ${latparam1}*sqrt(3)/2
variable b_vec equal 2.87*sqrt(3)/2

# ---------- 区域定义 ----------
region 1 block -.001 ${xdim} -.001 ${ydim} 0 63.270320055 units box
region 1 block -.001 77.05028017 -.001 ${ydim} 0 63.270320055 units box
region 1 block -.001 77.05028017 -.001 105.52861602 0 63.270320055 units box
region 2 block -.001 ${xdim} -.001 ${ydim} 63.270320055 126.54064011 units box
region 2 block -.001 77.05028017 -.001 ${ydim} 63.270320055 126.54064011 units box
region 2 block -.001 77.05028017 -.001 105.52861602 63.270320055 126.54064011 units box
region whole block 0 ${xdim} 0 ${ydim} 0.000000000000  126.540640110000  units box
region whole block 0 77.05028017 0 ${ydim} 0.000000000000  126.540640110000  units box
region whole block 0 77.05028017 0 105.52861602 0.000000000000  126.540640110000  units box
# ---------- 势函数 ----------
pair_style hybrid/overlay eam/alloy eam/fs

pair_coeff * * eam/alloy FeCrNi_d.eam.alloy Fe Cr Ni

pair_coeff * * eam/fs FeCrNi_s.eam.fs Fe Cr Ni
# ---------- 原子组 ----------
group top region 1   # 上层
43524 atoms in group top
group bot region 2   # 下层
43524 atoms in group bot
