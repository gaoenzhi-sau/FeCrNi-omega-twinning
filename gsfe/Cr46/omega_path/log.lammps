displace_atoms top2 move -${x_displace} 0.0 0.0 units box
displace_atoms top2 move -1.35 0.0 0.0 units box
Displacing atoms ...
displace_atoms top3 move -${x_displace} 0.0 0.0 units box
displace_atoms top3 move -1.35 0.0 0.0 units box
Displacing atoms ...

# 3. 如果 x_displace 大于 2b_vec且小于等于 3b_vec
if "${x_displace} > ${2b_vec}" then   "displace_atoms top1 move -${b_vec} 0.0 0.0 units box"   "displace_atoms top2 move -${2b_vec} 0.0 0.0 units box"   "displace_atoms top3 move -${x_displace} 0.0 0.0 units box"
fix 1 all setforce 0 0 NULL
min_style cg
minimize 1e-15 1e-15 10000 10000
